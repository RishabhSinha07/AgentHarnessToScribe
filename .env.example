# Copy to .env and fill in. `.env` is gitignored and must stay that way.
# Narration falls back to the browser's built-in speech if this is unset.

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Starting voice and model; the voice is switchable live in the UI.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_turbo_v2_5
